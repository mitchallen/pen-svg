node_modules/
.DS_Store
.npmrc
*.tgz

# Generated test output. writeSVG rewrites these on every run and random-test
# is non-deterministic, so tracking them produces churn. placeholder.txt is
# kept so the directory still exists in a fresh clone for the tests to write
# into -- without it the suite fails with ENOENT.
**/test/output/*
!**/test/output/placeholder.txt
